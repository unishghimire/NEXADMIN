# ==============================================================================
# NEXPLAY ADMIN SUITE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SAFE CONFIGURATION (Vite bundles these with browser JS)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com
VITE_MAIN_APP_URL=https://www.nexplayorg.app
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# ------------------------------------------------------------------------------
# 2. VERCEL SERVER-SIDE SECRETS (NEVER expose to frontend; NO VITE_ prefix!)
# ------------------------------------------------------------------------------
# Option A: Full Service Account JSON String
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'

# Option B: Individual Firebase Admin SDK credentials
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com

# Admin initial bootstrap key (used only via /api/admin/bootstrap)
ADMIN_BOOTSTRAP_KEY=your_secure_random_bootstrap_key_here

# ImgBB API Key for server-side image uploads
IMGBB_API_KEY=your_imgbb_api_key_here
